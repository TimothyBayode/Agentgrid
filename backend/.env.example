NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Privy server-only credentials.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Supabase (server-side only; the service role key bypasses RLS).
# Project URL: Settings > API. Service role key: Settings > API > Project API keys.
# Run `supabase/schema.sql` in the SQL editor before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ERC-8004 agent discovery. Chain is "testnet" (BSC Testnet, chainId 97) or "mainnet" (BSC, chainId 56).
ERC8004_CHAIN=testnet
# Optional RPC overrides. Defaults use public endpoints.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com
